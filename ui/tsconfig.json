{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./pkg/clusterstacks/*"]
    },
    "types": ["node", "webpack-env"],
    "allowJs": true,
    "jsx": "preserve"
  },
  "include": ["pkg/**/*.ts", "pkg/**/*.tsx", "pkg/**/*.vue"],
  "exclude": ["node_modules"]
}
