{
  "name": "clusterstacks-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Rancher Dashboard UI Extension for ClusterStacks with OpenStack integration",
  "scripts": {
    "build": "yarn --cwd pkg/clusterstacks build",
    "dev": "yarn --cwd pkg/clusterstacks dev",
    "lint": "yarn --cwd pkg/clusterstacks lint",
    "publish-pkg": "yarn --cwd pkg/clusterstacks publish-pkg"
  },
  "dependencies": {
    "@rancher/shell": "0.6.2"
  },
  "devDependencies": {
    "@rancher/components": "0.3.0-alpha.1",
    "typescript": "~4.9.5"
  },
  "workspaces": [
    "pkg/*"
  ]
}
